# Copiar a .env.local y completar. NO se versiona.
# Al clonar para un cliente nuevo, esto es casi todo lo que cambia.

# --- Identidad del tenant (lo ÚNICO específico del cliente) ---
APP_DB_SCHEMA=erp_ejemplo            # el schema del cliente (ver scripts/provision.mjs)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://db-xxxx.neura.com.py
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # SOLO servidor; nunca NEXT_PUBLIC

# --- Para aprovisionar/migrar (solo en tooling, no en runtime de la app) ---
# SUPABASE_DB_URL=postgres://postgres:...@host:5432/postgres

# --- Facturación electrónica (SIFEN) — SOLO servidor ---
# Clave para cifrar (AES-256-GCM) la contraseña del certificado .p12, el CSC y las claves
# tributarias de clientes antes de guardarlos en la base. 32+ caracteres aleatorios, distinta por
# cliente/deploy y NUNCA NEXT_PUBLIC. Si se pierde o se cambia, hay que volver a cargar esos secretos.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# SIFEN_SECRETS_KEY=

# --- Soporte de Neura (botón "Hablar con soporte" al llegar al límite de usuarios del plan) ---
# Por defecto abre el WhatsApp de Neura (595973989068). Para cambiarlo: otro número (solo dígitos) o una URL.
# NEXT_PUBLIC_SOPORTE_NEURA_WHATSAPP=
# NEXT_PUBLIC_SOPORTE_NEURA_URL=
